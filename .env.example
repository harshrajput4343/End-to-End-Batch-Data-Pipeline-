# AWS Configuration
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=your-data-bucket

# Redshift Configuration
REDSHIFT_HOST=your-redshift-cluster-url
REDSHIFT_PORT=5439
REDSHIFT_DB=dev
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=your-secure-password
REDSHIFT_IAM_ROLE=arn:aws:iam::123456789012:role/RedshiftS3ReadRole

# dbt Environment
DBT_PROFILES_DIR=.
